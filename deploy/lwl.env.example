# Настройки сайта LWL. На машине файл лежит в /etc/lwl/lwl.env (права 640, root:lwl).
# После правки: sudo systemctl restart lwl

# Адрес сайта снаружи (для ссылок сброса пароля). С https:// — куки будут Secure.
LWL_PUBLIC_URL=https://example.ru

# Владельцы сайта — всегда админы. Почта или ник, через запятую.
LWL_ADMINS=you@example.com

# Где лежат база и загруженные сборки
LWL_DATA_DIR=/var/lib/lwl

# Сайт слушает только локально, наружу его отдаёт nginx
LWL_HOST=127.0.0.1
LWL_PORT=8080
LWL_TRUST_PROXY=1

# Максимальный размер файла сборки, МБ (в nginx client_max_body_size должен быть не меньше)
LWL_MAX_UPLOAD_MB=2048

# Автодобавление в вайтлист при одобрении заявки — через RCON Minecraft-сервера (enable-rcon=true,
# rcon.password в server.properties). Пусто — выключено: команду вводят вручную. Порт 25575 наружу не открывать.
LWL_RCON_PASSWORD=
#LWL_RCON_HOST=127.0.0.1
#LWL_RCON_PORT=25575
