# Сайт LWL как служба systemd: стартует при загрузке машины и перезапускается при падении.
# Ставится скриптом deploy/install.sh в /etc/systemd/system/lwl.service
[Unit]
Description=LWL — сайт Minecraft-сервера
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lwl
Group=lwl
EnvironmentFile=/etc/lwl/lwl.env
WorkingDirectory=/opt/lwl
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=always
RestartSec=3
# Защита: сайт может писать только в свою папку с данными.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/lwl

[Install]
WantedBy=multi-user.target
