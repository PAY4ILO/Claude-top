{
  "name": "lwl-site",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт minecraft-сервера LWL: лендинг, личный кабинет и сервер (Node.js + SQLite, без зависимостей).",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "cli": "node --disable-warning=ExperimentalWarning server/cli.js",
    "test": "node --disable-warning=ExperimentalWarning tests/e2e.mjs",
    "test:api": "node --disable-warning=ExperimentalWarning --test tests/api.test.mjs",
    "figma:export": "node tools/figma-export.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
